# Kopiera till .env.local. Lägg aldrig riktiga hemligheter i Git.
APP_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Generera: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Beständig lokal disk krävs. SQLite innehåller enbart server-sessioner.
SESSION_DB_PATH=.data/sessions.sqlite
# Wiki använder Git på servern. Valfria inställningar:
WIKI_ENABLED=true
WIKI_TEMP_DIR=.data/wiki-tmp
# Tomt värde använder git i PATH.
GIT_EXECUTABLE=
