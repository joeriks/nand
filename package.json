{
  "name": "nand",
  "version": "0.3.5",
  "description": "Notes and more — samla, organisera och redigera din kunskap",
  "repository": {
    "type": "git",
    "url": "https://github.com/joeriks/nand.git"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "vite --config desktop/vite.config.ts",
    "desktop:frontend": "vite build --config desktop/vite.config.ts",
    "desktop:preview": "vite preview --config desktop/vite.config.ts --host 127.0.0.1 --port 1420",
    "tauri": "node scripts/tauri.mjs",
    "desktop:build": "node scripts/tauri.mjs build",
    "test:desktop": "node scripts/verify-desktop.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-opener": "2.5.5",
    "@tauri-apps/plugin-updater": "2.12.0",
    "@uiw/react-codemirror": "4.25.11",
    "idb": "8.0.3",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "node-diff3": "3.2.1",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.6.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "fake-indexeddb": "6.2.5",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
