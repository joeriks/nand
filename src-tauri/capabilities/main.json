{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the local editor window can call the application's commands.",
  "windows": ["main", "editor-*"],
  "permissions": ["core:default", "core:window:allow-close", "core:window:allow-destroy", { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }, { "url": "http://*" }, { "url": "mailto:*" }] }]
}
