{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nand",
  "version": "0.3.5",
  "identifier": "se.gitbsidian.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare && npm run desktop:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run desktop:prepare && npm run desktop:frontend",
    "frontendDist": "../desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "nand — Notes and more",
        "width": 1250,
        "height": 830,
        "minWidth": 760,
        "minHeight": 540,
        "backgroundColor": "#fffefa"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Notes and more — anteckningar, kunskap och CSV-tabeller",
    "homepage": "https://github.com/joeriks/nand",
    "category": "Productivity",
    "externalBin": [
      "binaries/gitbsidian-node"
    ],
    "resources": [
      "resources/backend.cjs",
      "resources/NODE-LICENSE.txt",
      "resources/THIRD-PARTY-NOTICES.txt"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Swedish",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3Qzk5MkJCRkFCOUQ5RjYKUldUMjJibjZ1NUxKNTJxK0xHSktSMG1adzliZ0M3Z3ZobCtpc2JWeEtucjcxVGRFc0xRN0tNNVYK",
      "endpoints": [
        "https://github.com/joeriks/nand/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
